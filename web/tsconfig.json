{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "spacetimedb": ["./node_modules/spacetimedb"],
      "spacetimedb/*": ["./node_modules/spacetimedb/dist/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../module_bindings/**/*.ts"]
}
