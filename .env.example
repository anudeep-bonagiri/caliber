# SpacetimeDB (local demo server; see scripts/demo_up.sh)
STDB_URI=http://127.0.0.1:3100
STDB_DB=dispatch-ledger
STDB_SEED_TOKEN=
STDB_AGENT_TOKEN=
STDB_CONTROLLER_TOKEN=
STDB_READER_TOKEN=
STDB_SEED_IDENTITY=
STDB_AGENT_IDENTITY=
STDB_CONTROLLER_IDENTITY=
STDB_READER_IDENTITY=
VITE_STDB_URI=http://127.0.0.1:3100
VITE_STDB_DB=dispatch-ledger

# Worker: live | record | replay (replay needs no keys)
WORKER_MODE=replay
FACTORY_API_KEY=
ANTHROPIC_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
KIBANA_URL=
# Least-privilege key Droid sends to the Agent Builder MCP endpoint (read and view_index_metadata on six indices plus the Kibana Agent Builder and actions read features, as elastic/make_mcp_key.py requests; not yet created, so the worker uses ELASTIC_API_KEY until it is).
# Created in the Kibana UI (docs/evidence/elastic/scoped_key_request.md); the worker falls back to ELASTIC_API_KEY when empty.
ELASTIC_MCP_API_KEY=

# Settlement through Capital One's Nessie mock bank (scripts/nessie_seed.py, worker/src/settle.ts).
# Empty key or WORKER_MODE=replay writes offline-<txnRef> ids instead of calling the bank.
NESSIE_API_KEY=
NESSIE_BASE=https://api.nessieisreal.com
# Cap on bank transfers per second across the settlers (a full live run is about 7,900 transfers).
NESSIE_MAX_PER_SECOND=5

# ASI:One agents. The controller seat (agent/agent.py) and the read-only investigator (agent/investigator.py).
# Each seed fixes its agent's address; never change a seed after registering on Agentverse.
AGENT_SEED=
AGENT_PORT=8000
INVESTIGATOR_SEED=
INVESTIGATOR_PORT=8012
# Printed by the running investigator; the controller forwards `why` and `status` to this address.
INVESTIGATOR_ADDRESS=
# ASI:One sender addresses (comma-separated agent1q...) allowed to write through the controller seat: answer,
# approve, reject, approve/reject rule, pause, resume, step. Empty means nobody may write; reads stay open to all.
# A refused sender gets "not authorised for this seat" and logs/agent.log records the full sender address.
ASI_ALLOWED_SENDERS=
ASI_ONE_API_KEY=

# Chat feed (scripts/discord_feed.py): outbound only, posts each new public audit_event row to every incoming webhook set here; both empty means the feed is off.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional; every one of these has a default in code (worker/src/config.ts, worker/src/crs.ts, elastic/common.py, agent/intents.py, agent/peers.py). Leave empty to use the default.
CRS_USERNAME=
CRS_PASSWORD=
CRS_BASE_URL=
CRS_DRY_RUN=
CRS_FIXTURES_DIR=
CRS_TIMEOUT_MS=
NESSIE_ACCOUNTS=
EVIDENCE_DIR=
FIXTURES_DIR=
COST_LOG=
PAUSE_FILE=
CONCURRENCY=
TASK_TIMEOUT_MS=
TASK_GRACE_MS=
POLL_MS=
EMBEDDING_INFERENCE_ID=
AGENT_ID=
ASI_ONE_MODEL=
AGENT_PEER_PATH=
