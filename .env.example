# SpacetimeDB (local demo server; see scripts/demo_up.sh)
STDB_URI=http://127.0.0.1:3100
STDB_DB=dispatch-ledger
STDB_SEED_TOKEN=
STDB_AGENT_TOKEN=
STDB_CONTROLLER_TOKEN=
STDB_READER_TOKEN=
STDB_SEED_IDENTITY=
STDB_AGENT_IDENTITY=
STDB_CONTROLLER_IDENTITY=
STDB_READER_IDENTITY=
VITE_STDB_URI=http://127.0.0.1:3100
VITE_STDB_DB=dispatch-ledger

# Worker: live | record | replay (replay needs no keys)
WORKER_MODE=replay
FACTORY_API_KEY=
ANTHROPIC_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
KIBANA_URL=

# Settlement through Capital One's Nessie mock bank (scripts/nessie_seed.py, worker/src/settle.ts).
# Empty key or WORKER_MODE=replay writes offline-<txnRef> ids instead of calling the bank.
NESSIE_API_KEY=
NESSIE_BASE=https://api.nessieisreal.com
# Cap on bank transfers per second across the settlers (a full live run is about 7,900 transfers).
NESSIE_MAX_PER_SECOND=5

# ASI:One agents. The controller seat (agent/agent.py) and the read-only investigator (agent/investigator.py).
# Each seed fixes its agent's address; never change a seed after registering on Agentverse.
AGENT_SEED=
AGENT_PORT=8000
INVESTIGATOR_SEED=
INVESTIGATOR_PORT=8012
# Printed by the running investigator; the controller forwards `why` and `status` to this address.
INVESTIGATOR_ADDRESS=
ASI_ONE_API_KEY=
