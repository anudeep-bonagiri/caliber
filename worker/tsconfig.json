{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "spacetimedb": ["./node_modules/spacetimedb"],
      "spacetimedb/*": ["./node_modules/spacetimedb/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../module_bindings/**/*.ts"]
}
