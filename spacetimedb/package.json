{
  "name": "dispatch-ledger-module",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "spacetime build",
    "generate": "spacetime generate --lang typescript --out-dir ../module_bindings --module-path . --yes",
    "publish:local": "spacetime publish dispatch-ledger --module-path . --server http://127.0.0.1:3100 --yes",
    "publish:local:reset": "spacetime publish dispatch-ledger --module-path . --server http://127.0.0.1:3100 --delete-data always --yes",
    "test": "vitest run"
  },
  "dependencies": { "spacetimedb": "2.13.0" },
  "devDependencies": { "typescript": "~5.6.2", "vitest": "^3.2.4" }
}
